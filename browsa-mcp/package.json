{
  "name": "@browsa/mcp",
  "version": "0.8.2",
  "mcpName": "io.browsa/browsa",
  "description": "MCP server for Browsa: real cloud browsers (Phantom) for Claude, Cursor, VS Code and any MCP client, and captcha solving for a browser of your own",
  "license": "MIT",
  "author": "Browsa <support@browsa.io>",
  "homepage": "https://browsa.io",
  "bugs": {
    "url": "https://github.com/browsa-io/browsa/issues",
    "email": "support@browsa.io"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "anthropic",
    "browser-automation",
    "real-browser",
    "ai-agents",
    "browser-use"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "browsa-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsup src/server.ts --format esm --target node18 --clean --shims",
    "test": "npm run build:test --silent && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/server.js",
    "build:test": "tsup src/captcha/detect.ts src/captcha/apply.ts src/captcha/guards.ts src/captcha/tools.ts src/retry.ts src/redact.ts src/prompts.ts --format esm --target node18 --out-dir test/dist --clean --silent",
    "tokens": "node scripts/tool-tokens.mjs",
    "bundle": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "browsa": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "linkedom": "^0.18.15",
    "tsup": "^8",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/browsa-io/browsa.git",
    "directory": "browsa-mcp"
  }
}
