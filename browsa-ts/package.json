{
  "name": "browsa",
  "version": "0.7.1",
  "description": "Official TypeScript SDK for Browsa: real cloud browsers for AI agents (browsa.io)",
  "license": "MIT",
  "author": "Browsa <support@browsa.io>",
  "homepage": "https://browsa.io",
  "bugs": {
    "url": "https://github.com/browsa-io/browsa/issues",
    "email": "support@browsa.io"
  },
  "keywords": [
    "browser-automation",
    "ai-agents",
    "browser-use",
    "real-browser",
    "scraping",
    "playwright",
    "puppeteer"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "bin": {
    "browsa": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/webhooks.ts src/cli.ts --format esm,cjs --dts --clean",
    "test": "node --test test/*.test.mjs",
    "test:live": "npm run build && node --test test/live.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/browsa-io/browsa.git",
    "directory": "browsa-ts"
  },
  "typesVersions": {
    "*": {
      "webhooks": [
        "./dist/webhooks.d.cts"
      ]
    }
  }
}
